<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginVertical="10dp" app:cardElevation="2dp" app:cardCornerRadius="24dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/surface">

    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp">

        <ImageView android:id="@+id/courseIcon" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/logo_icon_only" android:padding="12dp" android:background="@drawable/bg_icon_rounded" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />


        <TextView android:id="@+id/courseName" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Course Name" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginStart="18dp" app:layout_constraintTop_toTopOf="@id/courseIcon" app:layout_constraintStart_toEndOf="@id/courseIcon" app:layout_constraintEnd_toEndOf="parent" />


        <TextView android:id="@+id/courseCode" android:layout_width="0dp" android:layout_height="wrap_content" android:text="SWE224" android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginTop="2dp" app:layout_constraintTop_toBottomOf="@id/courseName" app:layout_constraintStart_toStartOf="@id/courseName" app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton android:id="@+id/openButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open Course" android:textSize="12sp" android:textColor="@color/primary" android:textAllCaps="false" app:icon="@android:drawable/ic_menu_directions" app:iconSize="16dp" app:layout_constraintTop_toBottomOf="@id/courseCode" app:layout_constraintStart_toStartOf="@id/courseName" android:layout_marginTop="8dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
