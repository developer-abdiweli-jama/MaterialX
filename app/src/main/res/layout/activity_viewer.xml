<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#2C3E50">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/viewerToolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="Material Viewer" app:titleTextColor="@color/white" app:navigationIcon="@drawable/ic_back" app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/pdfRecyclerView" android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintTop_toBottomOf="@id/viewerToolbar" app:layout_constraintBottom_toTopOf="@id/bottomControls" />


    <LinearLayout android:id="@+id/bottomControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#80000000" android:padding="16dp" android:orientation="horizontal" android:gravity="center" app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton android:id="@+id/zoomOut" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_zoom_out" android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textColor="@color/white" android:layout_marginHorizontal="24dp" />

        <ImageButton android:id="@+id/zoomIn" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_zoom_in" android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
